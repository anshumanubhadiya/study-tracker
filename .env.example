# Local development: embedded PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app_db

# Production/Supabase: replace with the Supabase Session Pooler URI
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres

# Use a long random value in production. Never commit the real secret.
SESSION_SECRET=replace-with-a-long-random-secret